{
  "name": "@flowdoc/core",
  "version": "0.1.0",
  "description": "Shared types and schema utilities for flowdoc",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
